{
  "name": "flaredrive",
  "version": "0.1.0",
  "description": "Static for queries, dynamic for mutations: React Server Components for reading, explicit HTTP APIs for writing. No Server Functions.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "flaredrive": "./bin/flaredrive.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "@hono/node-server": "2.1.4",
    "@vitejs/plugin-react": "6.1.2",
    "rsc-html-stream": "0.0.8"
  },
  "peerDependencies": {
    "@vitejs/plugin-rsc": "^0.5.36",
    "hono": "^4.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/dom-navigation": "1.0.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-rsc": "0.5.36",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
